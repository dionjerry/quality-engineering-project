{
  "name": "ubulu-restful-booker-api-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "service:up": "node scripts/compose.mjs up -d --wait",
    "service:down": "node scripts/compose.mjs down",
    "test": "playwright test",
    "test:ci": "playwright test",
    "test:smoke": "playwright test tests/health.spec.ts",
    "test:auth": "playwright test tests/authentication.spec.ts",
    "test:authorization": "playwright test tests/authorization.spec.ts",
    "test:crud": "playwright test tests/crud.spec.ts",
    "test:schema": "playwright test tests/schema-validation.spec.ts",
    "test:negative": "playwright test tests/negative-boundary.spec.ts",
    "test:filtering": "playwright test tests/filtering.spec.ts",
    "test:phase2": "playwright test tests/authentication.spec.ts tests/authorization.spec.ts tests/crud.spec.ts tests/schema-validation.spec.ts tests/negative-boundary.spec.ts tests/filtering.spec.ts",
    "test:local": "npm run service:up && npm test",
    "test:report": "playwright show-report playwright-report",
    "report:merge": "playwright merge-reports --config=playwright.merge.config.ts all-blob-reports",
    "report:site": "node scripts/build-report-site.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test:smoke"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0"
  },
  "engines": {
    "node": ">=22"
  }
}
